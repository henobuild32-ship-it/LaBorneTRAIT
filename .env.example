# ============================================================
# LaBorneTRAIT — Variables d'environnement (exemple)
# Copier en `.env` et renseigner les valeurs réelles.
# NEVER committer le vrai `.env` (il contient des secrets).
# ============================================================

# --- URL publique ---
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# --- Base de données PostgreSQL (Supabase via Prisma) ---
# DATABASE_URL : pooler (pgbouncer) pour l'app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# DIRECT_URL : connexion directe (migrations / prisma db push)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Auth JWT (sessions en cookie HTTP-only) ---
# IMPORTANT : utiliser des secrets longs et aléatoires en production (min 32 chars).
JWT_SECRET="change-me-with-a-long-random-string-access"
JWT_REFRESH_SECRET="change-me-with-a-long-random-string-refresh"

# --- Secret d'administration système ---
# Utilisé pour sécuriser : /api/admin/fix-subscription, /api/admin/db-health, /api/debug/env
# OBLIGATOIRE : aucune fallback sur JWT_SECRET (fail-closed).
# Générer avec : openssl rand -hex 32
ADMIN_API_SECRET="change-me-with-a-long-random-admin-secret"
# Cle dediee pour /api/admin/db-health (header Bearer uniquement, jamais en query).
HEALTHCHECK_SECRET_KEY="change-me-with-a-long-random-healthcheck-secret"

# --- Supabase (Realtime + Storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
# Clé service_role (côté serveur uniquement, jamais exposée au client)
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
# Nom du bucket Storage pour les fichiers (cours, devoirs, ressources, logos)
SUPABASE_STORAGE_BUCKET="gradeup"

# --- IA Teno (LaBorneTRAIT AI) ---
# GLM (recommandé, fournisseur principal)
GLM_API_KEY="YOUR-GLM-API-KEY"
GLM_MODEL="glm-4.5-flash"
# OpenRouter (fallback optionnel)
OR_API_KEY="YOUR-OPENROUTER-KEY"
OR_MODEL="deepseek/deepseek-chat-v3-0324:free"
# DeepSeek (fallback optionnel)
DEEPSEEK_API_KEY="YOUR-DEEPSEEK-KEY"

# --- Notifications Push (Web Push / PWA) ---
# Générer une paire VAPID avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="YOUR-VAPID-PUBLIC-KEY"
VAPID_PRIVATE_KEY="YOUR-VAPID-PRIVATE-KEY"

# --- Paiements (GeniusPay) ---
GENIUSPAY_API_BASE_URL="https://geniuspay.ci/api/v1/merchant"
GENIUSPAY_API_KEY="pk_live_or_sandbox_placeholder"
GENIUSPAY_API_SECRET="sk_live_or_sandbox_placeholder"
# Secret HMAC pour valider les callbacks de paiement (success URL)
# IMPORTANT : doit correspondre à ce qui est configuré côté GeniusPay comme "webhook secret"
# Utiliser JWT_SECRET en fallback si absent, mais configurer ce champ explicitement est recommandé.
GENIUSPAY_WEBHOOK_SECRET="change-me-with-geniuspay-webhook-secret"

# --- Email (Nodemailer / SMTP) — utilisé pour l'OTP mot de passe oublié ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"          # true si port 465
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="no-reply@example.com"
SMTP_REJECT_UNAUTHORIZED="false"

# --- Notifications Push OneSignal (en complément du Web Push PWA) ---
NEXT_PUBLIC_ONESIGNAL_APP_ID="YOUR-ONESIGNAL-APP-ID"
ONESIGNAL_REST_API_KEY="YOUR-ONESIGNAL-REST-API-KEY"
# Alias accepté (si vous utilisez le nom brut du dashboard)
ONESIGNAL_REST_API="YOUR-ONESIGNAL-REST-API-KEY"
